@page
@using BandFlow.Data
@model BandFlow.Pages.Cotizaciones.IndexModel
@{ ViewData["Title"] = "Cotizaciones"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Cotizaciones</h1>
    <a class="btn btn-primary" asp-page="Nueva">+ Nueva cotización</a>
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-3"><label class="form-label small mb-0">Banda o promotor</label>
        <input name="Buscar" value="@Model.Buscar" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label small mb-0">Estado</label>
        <select name="Estado" class="form-select">
            <option value="">Todos</option>
            @foreach (var e in new[] { "Pendiente", "Aprobada", "Rechazada" })
            {
                <option value="@e" selected="@(Model.Estado == e)">@e</option>
            }
        </select></div>
    <div class="col-md-2"><label class="form-label small mb-0">Desde</label>
        <input type="date" name="Desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label small mb-0">Hasta</label>
        <input type="date" name="Hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-outline-light">Filtrar</button>
        <a class="btn btn-link" asp-page="Index">Limpiar</a></div>
</form>

@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
else if (!Model.Lista.Any()) { <div class="alert alert-secondary">No hay cotizaciones con esos filtros.</div> }
else
{
    <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>#</th><th>Banda</th><th>Promotor</th><th>Fecha</th><th>Total</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model.Lista)
        {
            <tr>
                <td>@c.Id</td><td>@c.Banda</td><td>@c.Promotor</td>
                <td>@Fmt.Fecha(c.Inicio)</td><td>@Fmt.Money(c.Total)</td>
                <td><span class="badge-estado estado-@c.Estado">@c.Estado</span></td>
                <td class="text-end"><a class="btn btn-sm btn-outline-light" asp-page="Detalle" asp-route-id="@c.Id">Ver detalle</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
