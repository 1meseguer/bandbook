@page "{id:int?}"
@model BandFlow.Pages.Categorias.EditModel
@{ ViewData["Title"] = Model.Id == null ? "Nueva categoría" : "Editar categoría"; }

<h1 class="mb-3">@ViewData["Title"]</h1>
<div class="row"><div class="col-md-6">
<form method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Nombre" class="form-label">Nombre</label>
        <input asp-for="Input.Nombre" class="form-control" maxlength="50" />
        <span asp-validation-for="Input.Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Precio" class="form-label">Tarifa base (MXN)</label>
        <input asp-for="Input.Precio" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="Input.Precio" class="text-danger"></span>
    </div>
    <div>
        <button class="btn btn-primary">Guardar</button>
        <a class="btn btn-link" asp-page="Index">Cancelar</a>
    </div>
</form>
</div></div>
