@page
@using BandFlow.Data
@model BandFlow.Pages.Categorias.IndexModel
@{ ViewData["Title"] = "Categorías"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Categorías</h1>
    <a class="btn btn-primary" asp-page="Edit">+ Nueva categoría</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-5 col-md-4"><input name="Buscar" value="@Model.Buscar" class="form-control" placeholder="Buscar categoría..." /></div>
    <div class="col-auto"><button class="btn btn-outline-light">Buscar</button></div>
    @if (!string.IsNullOrWhiteSpace(Model.Buscar)) { <div class="col-auto"><a class="btn btn-link" asp-page="Index">Limpiar</a></div> }
</form>

@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
else if (!Model.Lista.Any()) { <div class="alert alert-secondary">No se encontraron categorías.</div> }
else
{
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Categoría</th><th>Tarifa base</th><th>Bandas</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var c in Model.Lista)
        {
            <tr>
                <td>@c.Nombre</td><td>@Fmt.Money(c.Precio)</td><td>@c.Bandas</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-light" asp-page="Edit" asp-route-id="@c.Id">Editar</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" class="d-inline"
                          onsubmit="return confirm('¿Eliminar la categoría @c.Nombre?');">
                        <button class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
