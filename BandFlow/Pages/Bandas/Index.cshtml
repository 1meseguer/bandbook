@page
@using BandFlow.Data
@model BandFlow.Pages.Bandas.IndexModel
@{ ViewData["Title"] = "Bandas"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Catálogo de bandas</h1>
    <a class="btn btn-primary" asp-page="Edit">+ Nueva banda</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4"><input name="Buscar" value="@Model.Buscar" class="form-control" placeholder="Buscar por nombre o género..." /></div>
    <div class="col-auto"><button class="btn btn-outline-light">Buscar</button></div>
    @if (!string.IsNullOrWhiteSpace(Model.Buscar)) { <div class="col-auto"><a class="btn btn-link" asp-page="Index">Limpiar</a></div> }
</form>

@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
else if (!Model.Lista.Any()) { <div class="alert alert-secondary">No se encontraron bandas.</div> }
else
{
    <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Banda</th><th>Género</th><th>Categoría</th><th>Tarifa base</th><th>Comisión</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var b in Model.Lista)
        {
            <tr>
                <td>@b.Nombre</td><td>@b.Genero</td><td>@b.Categoria</td>
                <td>@Fmt.Money(b.Precio)</td><td>@b.Comision.ToString("0.##")%</td>
                <td>@(b.Activa ? "Activa" : "Inactiva")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-light" asp-page="Edit" asp-route-id="@b.Id">Editar</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@b.Id" class="d-inline"
                          onsubmit="return confirm('¿Eliminar la banda @b.Nombre?');">
                        <button class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
