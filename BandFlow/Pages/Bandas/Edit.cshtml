@page "{id:int?}"
@model BandFlow.Pages.Bandas.EditModel
@{ ViewData["Title"] = Model.Id == null ? "Nueva banda" : "Editar banda"; }

<h1 class="mb-3">@ViewData["Title"]</h1>
<div class="row"><div class="col-lg-7">
<form method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.Nombre" class="form-label">Nombre de la banda</label>
            <input asp-for="Input.Nombre" class="form-control" maxlength="100" />
            <span asp-validation-for="Input.Nombre" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Genero" class="form-label">Género musical</label>
            <input asp-for="Input.Genero" class="form-control" maxlength="60" />
            <span asp-validation-for="Input.Genero" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.IdCategoria" class="form-label">Categoría</label>
            <select asp-for="Input.IdCategoria" asp-items="Model.Categorias" class="form-select">
                <option value="0">-- Selecciona --</option>
            </select>
            <span asp-validation-for="Input.IdCategoria" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Comision" class="form-label">Comisión de la agencia (%)</label>
            <input asp-for="Input.Comision" type="number" step="0.01" min="0" max="100" class="form-control" />
            <span asp-validation-for="Input.Comision" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.Contacto" class="form-label">Contacto principal (teléfono o correo)</label>
            <input asp-for="Input.Contacto" class="form-control" maxlength="100" />
            <span asp-validation-for="Input.Contacto" class="text-danger"></span>
        </div>
        <div class="col-12 form-check ms-2">
            <input asp-for="Input.Activa" class="form-check-input" />
            <label asp-for="Input.Activa" class="form-check-label">Banda activa (disponible para cotizar)</label>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary">Guardar</button>
        <a class="btn btn-link" asp-page="Index">Cancelar</a>
    </div>
</form>
</div></div>
