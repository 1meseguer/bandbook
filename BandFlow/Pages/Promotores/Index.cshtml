@page
@model BandFlow.Pages.Promotores.IndexModel
@{ ViewData["Title"] = "Promotores"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Promotores</h1>
    <a class="btn btn-primary" asp-page="Edit">+ Nuevo promotor</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4"><input name="Buscar" value="@Model.Buscar" class="form-control" placeholder="Buscar por nombre o correo..." /></div>
    <div class="col-auto"><button class="btn btn-outline-light">Buscar</button></div>
    @if (!string.IsNullOrWhiteSpace(Model.Buscar)) { <div class="col-auto"><a class="btn btn-link" asp-page="Index">Limpiar</a></div> }
</form>

@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
else if (!Model.Lista.Any()) { <div class="alert alert-secondary">No se encontraron promotores.</div> }
else
{
    <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Cotizaciones</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Lista)
        {
            <tr>
                <td>@p.Nombre</td><td>@p.Telefono</td><td>@p.Correo</td><td>@p.Cotizaciones</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-light" asp-page="Edit" asp-route-id="@p.Id">Editar</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" class="d-inline"
                          onsubmit="return confirm('¿Eliminar a @p.Nombre?');">
                        <button class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
