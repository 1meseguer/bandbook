@page
@using BandFlow.Data
@model BandFlow.Pages.Agenda.IndexModel
@{ ViewData["Title"] = "Agenda"; }

<h1 class="mb-3">Agenda de eventos</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="Estado" class="form-select">
            <option value="">Todos los estados</option>
            @foreach (var e in new[] { "Programado", "Realizado", "Cancelado" })
            {
                <option value="@e" selected="@(Model.Estado == e)">@e</option>
            }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-light">Filtrar</button></div>
</form>

@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
else if (!Model.Lista.Any()) { <div class="alert alert-secondary">No hay eventos en la agenda.</div> }
else
{
    <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Fecha</th><th>Banda</th><th>Promotor</th><th>Lugar</th><th>Total</th><th>Estado</th><th>Google Calendar</th></tr></thead>
        <tbody>
        @foreach (var e in Model.Lista)
        {
            <tr>
                <td>@Fmt.Fecha(e.Inicio)</td><td>@e.Banda</td><td>@e.Promotor</td><td>@e.Lugar</td>
                <td>@Fmt.Money(e.Total)</td>
                <td><span class="badge-estado estado-@e.Estado">@e.Estado</span></td>
                <td>@(e.GoogleId ?? "Pendiente")</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
